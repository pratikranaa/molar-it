# Cloudflare Pages redirects.
# Do NOT 200-rewrite /path → /path.html — Pages already serves pretty URLs
# (foo.html at /foo) and combining both causes a 308 loop.
# Clone documentation is pre-rendered at /docs/clones/:slug.

/cartographer /products/cartographer 301
/clones /products/clones 301
/guard /products/guard 301
/trace /products/trace 301
