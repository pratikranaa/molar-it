{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "cartographer.molar.it"
        }
      ],
      "dest": "/cartographer/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "clones.molar.it"
        }
      ],
      "dest": "/clones/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "guard.molar.it"
        }
      ],
      "dest": "/guard/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "trace.molar.it"
        }
      ],
      "dest": "/trace/index.html"
    },
    {
      "source": "/blog/ai-playwright-test-generation",
      "destination": "/blog/ai-playwright-test-generation.html"
    },
    {
      "source": "/blog/flaky-tests-causes-and-fixes",
      "destination": "/blog/flaky-tests-causes-and-fixes.html"
    },
    {
      "source": "/blog/self-healing-test-automation",
      "destination": "/blog/self-healing-test-automation.html"
    },
    {
      "source": "/blog/e2e-testing-best-practices",
      "destination": "/blog/e2e-testing-best-practices.html"
    },
    {
      "source": "/blog/github-actions-playwright-ci",
      "destination": "/blog/github-actions-playwright-ci.html"
    },
    {
      "source": "/blog/required-status-checks-merge-gate",
      "destination": "/blog/required-status-checks-merge-gate.html"
    },
    {
      "source": "/blog/synthetic-monitoring-production",
      "destination": "/blog/synthetic-monitoring-production.html"
    },
    {
      "source": "/blog/test-twilio-sms-otp-flows",
      "destination": "/blog/test-twilio-sms-otp-flows.html"
    },
    {
      "source": "/blog/email-workflow-testing-otp",
      "destination": "/blog/email-workflow-testing-otp.html"
    },
    {
      "source": "/blog/api-mocking-vs-service-clones",
      "destination": "/blog/api-mocking-vs-service-clones.html"
    },
    {
      "source": "/blog/regression-testing-strategies",
      "destination": "/blog/regression-testing-strategies.html"
    },
    {
      "source": "/blog/testing-third-party-apis-safely",
      "destination": "/blog/testing-third-party-apis-safely.html"
    },
    {
      "source": "/blog/continuous-testing-ci-cd-pipeline",
      "destination": "/blog/continuous-testing-ci-cd-pipeline.html"
    },
    {
      "source": "/blog/staging-environment-alternatives",
      "destination": "/blog/staging-environment-alternatives.html"
    },
    {
      "source": "/blog/ai-agents-future-software-testing",
      "destination": "/blog/ai-agents-future-software-testing.html"
    },
    {
      "source": "/blog/shift-left-testing-explained",
      "destination": "/blog/shift-left-testing-explained.html"
    },
    {
      "source": "/blog/playwright-vs-cypress-comparison",
      "destination": "/blog/playwright-vs-cypress-comparison.html"
    },
    {
      "source": "/blog/startup-qa-without-qa-team",
      "destination": "/blog/startup-qa-without-qa-team.html"
    },
    {
      "source": "/blog/test-data-management-best-practices",
      "destination": "/blog/test-data-management-best-practices.html"
    },
    {
      "source": "/blog/visual-regression-testing-guide",
      "destination": "/blog/visual-regression-testing-guide.html"
    }
  ],
  "redirects": [
    {
      "source": "/cartographer",
      "destination": "https://cartographer.molar.it",
      "permanent": true
    },
    {
      "source": "/clones",
      "destination": "https://clones.molar.it",
      "permanent": true
    },
    {
      "source": "/guard",
      "destination": "https://guard.molar.it",
      "permanent": true
    },
    {
      "source": "/trace",
      "destination": "https://trace.molar.it",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/api/instant-proof/:path*",
      "destination": "/api/instant-proof?__path=:path*"
    },
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/clones/:slug",
      "destination": "/docs/clone.html?slug=:slug"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    },
    {
      "source": "/thesis",
      "destination": "/thesis.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/qa-agent",
      "destination": "/qa-agent.html"
    },
    {
      "source": "/v4",
      "destination": "/v4/index.html"
    },
    {
      "source": "/v4/",
      "destination": "/v4/index.html"
    },
    {
      "source": "/vs/cypress",
      "destination": "/vs/cypress.html"
    },
    {
      "source": "/vs/playwright",
      "destination": "/vs/playwright.html"
    },
    {
      "source": "/vs/wiremock",
      "destination": "/vs/wiremock.html"
    },
    {
      "source": "/vs/checkly",
      "destination": "/vs/checkly.html"
    },
    {
      "source": "/vs/playwright-trace",
      "destination": "/vs/playwright-trace.html"
    },
    {
      "source": "/integrations/github-actions",
      "destination": "/integrations/github-actions.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/test-stripe-without-real-cards",
      "destination": "/blog/test-stripe-without-real-cards.html"
    }
  ],
  "headers": [
    {
      "source": "/verify",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob:; connect-src 'self'"
        }
      ]
    },
    {
      "source": "/verify.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob:; connect-src 'self'"
        }
      ]
    }
  ]
}
