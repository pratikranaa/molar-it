  "qa-agent.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Molar QA Agent — Autonomous End-to-End Testing Platform</title>\n  <meta name=\"description\" content=\"Molar is the autonomous QA agent that writes end-to-end tests, guards production in real time, and clones third-party APIs — so dev teams never use real cards, emails, or users in tests.\" />\n  <meta property=\"og:title\" content=\"Molar QA Agent — Autonomous End-to-End Testing Platform\" />\n  <meta property=\"og:description\" content=\"Point Molar at your app. It authors critical-path tests, runs continuous production checks, and opens fix PRs when regressions land.\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:url\" content=\"https://molar.it/qa-agent\" />\n  <meta property=\"og:image\" content=\"https://molar.it/og.png\" />\n  <meta property=\"og:image:width\" content=\"1200\" />\n  <meta property=\"og:image:height\" content=\"630\" />\n  <meta property=\"og:site_name\" content=\"Molar\" />\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Molar QA Agent — Autonomous End-to-End Testing Platform\" />\n  <meta name=\"twitter:description\" content=\"Autonomous QA agent for dev teams. Writes tests, guards production, clones Stripe/email/S3 safely.\" />\n  <meta name=\"twitter:image\" content=\"https://molar.it/og.png\" />\n  <link rel=\"canonical\" href=\"https://molar.it/qa-agent\" />\n\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n      {\n        \"@type\": \"BreadcrumbList\",\n        \"itemListElement\": [\n          { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Molar\", \"item\": \"https://molar.it/\" },\n          { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Molar QA Agent\", \"item\": \"https://molar.