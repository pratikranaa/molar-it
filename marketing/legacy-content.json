e; color: var(--ink-3); margin-bottom: 40px;\n    }\n    .doc-meta .num { color: var(--signal); font-weight: 500; }\n    .doc-meta .rule { flex: 1; height: 1px; background: var(--rule); }\n    .doc-grid {\n      display: grid; grid-template-columns: 240px minmax(0, 1fr);\n      gap: 80px; align-items: start;\n    }\n    .doc-sidebar {\n      position: sticky; top: 96px; display: flex; flex-direction: column; gap: 28px;\n      font-family: 'JetBrains Mono', monospace; font-size: 11px;\n      letter-spacing: 0.10em; text-transform: uppercase; color: var(--ink-3);\n    }\n    .doc-side-block { display: flex; flex-direction: column; gap: 8px; }\n    .doc-side-label { color: var(--signal); font-weight: 500; }\n    .doc-side-meta { color: var(--ink-2); font-size: 10.5px; letter-spacing: 0.10em; line-height: 1.45; }\n    .doc-toc {\n      display: flex; flex-direction: column; gap: 10px;\n      border-top: 1px solid var(--rule); padding-top: 18px;\n    }\n    .doc-toc a {\n      color: var(--ink-3); text-decoration: none; font-size: 11px;\n      letter-spacing: 0.08em; transition: color 160ms ease; line-height: 1.45;\n    }\n    .doc-toc a:hover { color: var(--signal); }\n    .doc-toc a span { color: var(--ink-3); margin-right: 8px; opacity: 0.65; }\n    .doc-article { display: flex; flex-direction: column; gap: 56px; }\n    .doc-kicker {\n      font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;\n      letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); margin-bottom: 16px;\n    }\n    .doc-title {\n      font-family: 'Instrument Serif', serif; font-size: clamp(48px, 6.4vw, 88px);\n      line-height: 0.98; letter-spacing: -0.025em; max-width: 14ch;\n    }\n    .doc-title em { font-style: italic; color: var(--signal); }\n    .doc-lede {\n      margin-top: 28px; max-width: 60ch; font-size: 19px; line-height: 1.55; color: var(--ink-2);\n    }\n    .doc-section { display: flex; flex-direction: column; gap: 20px; max-width: 64ch; }\n    .doc-section h2 {\n      font-family: 'Instrument Serif', serif; font-size: clamp(28px, 2.8vw, 36px);\n      line-height: 1.08; letter-spacing: -0.018em; font-weight: 400;\n    }\n    .doc-section h2 em { font-style: italic; color: var(--signal); }\n    .doc-section h2 .doc-section-num {\n      display: block; font-family: 'JetBrains Mono', monospace; font-size: 11px;\n      font-style: normal; color: var(--signal); letter-spacing: 0.14em;\n      text-transform: uppercase; margin-bottom: 10px; font-weight: 500;\n    }\n    .doc-section p { font-size: 17.5px; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }\n    .doc-section p strong { color: var(--ink); font-weight: 500; }\n    .doc-section ul { margin: 0; padding-left: 1.2em; color: var(--ink-2); font-size: 17px; line-height: 1.65; }\n    .doc-section li { margin-bottom: 8px; }\n    .doc-cta {\n      display: inline-flex; align-items: center; gap: 12px; margin-top: 8px;\n    }\n    .doc-back {\n      margin-top: 80px; display: inline-flex; align-items: center; gap: 6px;\n      font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em;\n      text-transform: uppercase; color: var(--ink-3); text-decoration: none;\n    }\n    .doc-back:hover { color: var(--signal); }\n    .doc-back .arrow { transition: transform 200ms ease; display: inline-block; }\n    .doc-back:hover .arrow { transform: translateX(-3px); }\n    @media (max-width: 960px) {\n      .doc-grid { grid-template-columns: 1fr; gap: 40px; }\n      .doc-sidebar { position: static; padding-bottom: 24px; border-bottom: 1px solid var(--rule); }\n      .doc-toc { border-top: 0; padding-top: 0; }\n    }\n  </style>\n</head>\n<body data-waitlist-surface=\"home\">\n  <div class=\"paper-grain\"></div>\n  <div id=\"nav-root\"></div>\n\n  <main class=\"doc-page\">\n    <div class=\"frame\">\n      <div class=\"doc-meta\">\n        <span class=\"num\">QA Agent</span>\n        <span class=\"rule\"></span>\n        <span>Molar / Product</span>\n      </div>\n\n      <div class=\"doc-grid\">\n        <aside class=\"doc-sidebar\">\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">Category</span>\n            <span class=\"doc-side-meta\">Autonomous QA agent · Continuous testing</span>\n          </div>\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">Built for</span>\n            <span class=\"doc-side-meta\">Engineering &amp; platform teams shipping web apps</span>\n          </div>\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">Setup</span>\n            <span class=\"doc-side-meta\">≈ 60 seconds · npx molar-agent init</span>\n          </div>\n\n          <nav class=\"doc-toc\" aria-label=\"Sections\">\n            <a href=\"#what\"><span>01</span>What is the Molar QA agent?</a>\n            <a href=\"#capabilities\"><span>02</span>What it does</a>\n            <a href=\"#different\"><span>03</span>How it's different</a>\n            <a href=\"#start\"><span>04</span>Get started</a>\n          </nav>\n        </aside>\n\n        <article class=\"doc-article\">\n          <header>\n            <p class=\"doc-kicker\">Molar — autonomous QA testing platform</p>\n            <h1 class=\"doc-title\">\n              The Molar QA agent writes tests<br/>\n              and <em>guards production.</em>\n            </h1>\n            <p class=\"doc-lede\">\n              <strong>Molar</strong> (molar.it) is an autonomous QA agent for software development teams —\n              not a dental or chemistry term. Point it at your app's URL: it maps critical paths,\n              authors end-to-end tests in plain English, and runs continuous production checks with\n              sandboxed emails, virtual cards, and cloned third-party APIs.\n            </p>\n          </header>\n\n          <section class=\"doc-section\" id=\"what\">\n            <h2>\n              <span class=\"doc-section-num\">01 — Definition</span>\n              What is the <em>Molar QA agent?</em>\n            </h2>\n            <p>\n              The <strong>Molar QA agent</strong> is an AI-powered software testing agent that replaces\n              manual test authoring and brittle Playwright maintenance. Instead of hand-writing scripts,\n              you give Molar a URL. It crawls your application, understands how users move through it,\n              and maintains a living suite of critical-path end-to-end tests.\n            </p>\n            <p>\n              The same agent guards <strong>production</strong> on a schedule — catching regressions\n              before customers report them — and can open a fix pull request when a check fails with\n              a full replayable trace.\n            </p>\n          </section>\n\n          <section class=\"doc-section\" id=\"capabilities\">\n            <h2>\n              <span class=\"doc-section-num\">02 — Capabilities</span>\n              What the QA agent <em>does</em>\n            </h2>\n            <ul>\n              <li><strong>Autonomous test authoring</strong> — crawls your app and writes critical-path E2E tests from a URL.</li>\n              <li><strong>Continuous production guard</strong> — scheduled checks against live URLs; required GitHub check on failure.</li>\n              <li><strong>Stateful third-party clones</strong> — Stripe, SendGrid, S3, Twilio, GitHub, Slack and ~28 more, with no real charges or emails.</li>\n              <li><strong>Trace capture &amp; replay</strong> — DOM, network, console, and clone activity for root-cause.</li>\n              <li><strong>Auto-fix (Mender)</strong> — opens a fix PR on confirmed regressions.</li>\n              <li><strong>MCP connector</strong> — other autonomous agents can run tests and read traces as tools.</li>\n            </ul>\n          </section>\n\n          <section class=\"doc-section\" id=\"different\">\n            <h2>\n              <span class=\"doc-section-num\">03 — Comparison</span>\n              Not a test runner. <em>A release guard.</em>\n            </h2>\n            <p>\n              Traditional QA tools expect you to write and maintain scripts. Synthetic monitoring\n              pings one URL. Molar is an <strong>autonomous QA agent</strong> that owns the full loop:\n              discover flows, write tests, gate PRs, shadow deploys, and watch production — with\n              destruction-safe clones so checkout tests never charge a real card.\n            </p>\n            <p>\n              If you searched for <strong>\"Molar QA agent\"</strong>, <strong>\"autonomous QA testing\"</strong>,\n              or <strong>\"AI agent that writes end-to-end tests\"</strong>, this is the product at molar.it.\n            </p>\n          </section>\n\n          <section class=\"doc-section\" id=\"start\">\n            <h2>\n              <span class=\"doc-section-num\">04 — Start</span>\n              Running the agent in <em>your repo</em>\n            </h2>\n            <p>\n              Install in under a minute. Paste your app URL, connect GitHub, and Molar starts\n              authoring and guarding critical paths. See the <a href=\"docs.html\" style=\"color:var(--signal);\">docs</a>\n              for quickstart steps, or return to the <a href=\"index.html\" style=\"color:var(--signal);\">main landing page</a>\n              for pricing and a live terminal demo.\n            </p>\n            <div class=\"doc-cta\">\n              <a href=\"https://app.molar.it\" class=\"btn btn-primary\">Join waitlist →</a>\n              <a href=\"docs.html\" class=\"btn btn-ghost\">Read the docs</a>\n            </div>\n          </section>\n\n          <a class=\"doc-back\" href=\"index.html\"><span class=\"arrow\">←</span> Back to landing</a>\n        </article>\n      </div>\n    </div>\n  </main>\n\n  <footer>\n    <div class=\"frame foot-inner\">\n      <div>© 2026 Molar Labs · Bengaluru</div>\n      <div style=\"display:flex; gap:24px;\">\n        <a href=\"qa-agent.html\" style=\"color:inherit;text-decoration:none;\">QA Agent</a>\n        <a href=\"docs.html\" style=\"color:inherit;text-decoration:none;\">Docs</a>\n        <a href=\"thesis.html\" style=\"color:inherit;text-decoration:none;\">Thesis</a>\n        <a href=\"mailto:pratik@molar.it\" style=\"color:inherit;text-decoration:none;\">Email</a>\n        <a href=\"https://github.com/pratikranaa/molar-it\" style=\"color:inherit;text-decoration:none;\">GitHub</a>\n      </div>\n    </div>\n  </footer>\n\n  <script src=\"https://unpkg.com/react@18.3.1/umd/react.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/@babel/standalone@7.29.0/babel.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"site-config.js\"></script>\n  <script type=\"text/babel\" src=\"nav.jsx\"></script>\n  <script type=\"text/babel\" src=\"nav-boot.jsx\"></script>\n  <script src=\"waitlist-modal.js\"></script>\n</body>\n</html>\n",
