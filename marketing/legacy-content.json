 \"2026-05-01\",\n        \"dateModified\": \"2026-06-27\",\n        \"author\": { \"@type\": \"Person\", \"name\": \"Pratik Rana\", \"url\": \"https://www.linkedin.com/in/ranapratik/\" },\n        \"publisher\": { \"@type\": \"Organization\", \"name\": \"Molar Labs\", \"logo\": { \"@type\": \"ImageObject\", \"url\": \"https://molar.it/assets/molar-mark-apple.png\" } }\n      }\n    ]\n  }\n  </script>\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n  <link rel=\"stylesheet\" href=\"waitlist-modal.css\" />\n  <style>\n    .doc-page {\n      padding: 64px 0 96px;\n      border-bottom: 1px solid var(--rule);\n    }\n    .doc-meta {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--ink-3);\n      margin-bottom: 40px;\n    }\n    .doc-meta .num { color: var(--signal); font-weight: 500; }\n    .doc-meta .rule { flex: 1; height: 1px; background: var(--rule); }\n\n    .doc-grid {\n      display: grid;\n      grid-template-columns: 240px minmax(0, 1fr);\n      gap: 80px;\n      align-items: start;\n    }\n    .doc-sidebar {\n      position: sticky;\n      top: 96px;\n      display: flex;\n      flex-direction: column;\n      gap: 28px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.10em;\n      text-transform: uppercase;\n      color: var(--ink-3);\n    }\n    .doc-side-block { display: flex; flex-direction: column; gap: 8px; }\n    .doc-side-label { color: var(--signal); font-weight: 500; }\n    .doc-side-value { color: var(--ink); font-family: 'Instrument Serif', serif; font-style: italic; font-size: 16px; letter-spacing: 0; text-transform: none; line-height: 1.35; }\n    .doc-side-meta { color: var(--ink-2); font-size: 10.5px; letter-spacing: 0.10em; }\n\n    .doc-toc {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      border-top: 1px solid var(--rule);\n      padding-top: 18px;\n    }\n    .doc-toc a {\n      color: var(--ink-3);\n      text-decoration: none;\n      font-size: 11px;\n      letter-spacing: 0.08em;\n      transition: color 160ms ease;\n      line-height: 1.45;\n    }\n    .doc-toc a:hover { color: var(--signal); }\n    .doc-toc a span { color: var(--ink-3); margin-right: 8px; opacity: 0.65; }\n\n    .doc-article { display: flex; flex-direction: column; gap: 56px; }\n    .doc-title {\n      font-family: 'Instrument Serif', serif;\n      font-size: clamp(48px, 6.4vw, 88px);\n      line-height: 0.98;\n      letter-spacing: -0.025em;\n      max-width: 16ch;\n    }\n    .doc-title em { font-style: italic; color: var(--signal); }\n    .doc-lede {\n      margin-top: 28px;\n      max-width: 60ch;\n      font-size: 22px;\n      line-height: 1.5;\n      color: var(--ink);\n      font-family: 'Instrument Serif', serif;\n      font-style: italic;\n      letter-spacing: -0.005em;\n    }\n\n    .doc-section { display: flex; flex-direction: column; gap: 20px; max-width: 64ch; }\n    .doc-section h2 {\n      font-family: 'Instrument Serif', serif;\n      font-size: clamp(28px, 2.8vw, 36px);\n      line-height: 1.08;\n      letter-spacing: -0.018em;\n      font-weight: 400;\n    }\n    .doc-section h2 em { font-style: italic; color: var(--signal); }\n    .doc-section h2 .doc-section-num {\n      display: block;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      font-style: normal;\n      color: var(--signal);\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      margin-bottom: 10px;\n      font-weight: 500;\n    }\n    .doc-section p {\n      font-size: 17.5px;\n      line-height: 1.7;\n      color: var(--ink-2);\n      text-wrap: pretty;\n    }\n    .doc-section p strong { color: var(--ink); font-weight: 500; }\n\n    .doc-pull {\n      font-family: 'Instrument Serif', serif;\n      font-style: italic;\n      font-size: clamp(26px, 2.6vw, 34px);\n      line-height: 1.22;\n      color: var(--ink);\n      max-width: 44ch;\n      padding: 18px 0 18px 24px;\n      border-left: 3px solid var(--signal);\n      margin: 12px 0;\n      text-wrap: balance;\n    }\n\n    .doc-back {\n      margin-top: 80px;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: var(--ink-3);\n      text-decoration: none;\n    }\n    .doc-back:hover { color: var(--signal); }\n    .doc-back .arrow { transition: transform 200ms ease; display: inline-block; }\n    .doc-back:hover .arrow { transform: translateX(-3px); }\n\n    @media (max-width: 960px) {\n      .doc-grid { grid-template-columns: 1fr; gap: 40px; }\n      .doc-sidebar { position: static; order: 0; padding-bottom: 24px; border-bottom: 1px solid var(--rule); }\n      .doc-toc { border-top: 0; padding-top: 0; }\n    }\n  </style>\n</head>\n<body data-waitlist-surface=\"thesis\">\n  <div class=\"paper-grain\"></div>\n  <div id=\"nav-root\"></div>\n\n  <main class=\"doc-page\">\n    <div class=\"frame\">\n      <div class=\"doc-meta\">\n        <span class=\"num\">Thesis</span>\n        <span class=\"rule\"></span>\n        <span>Molar / Volume 01</span>\n      </div>\n\n      <div class=\"doc-grid\">\n        <aside class=\"doc-sidebar\">\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">By</span>\n            <span class=\"doc-side-value\">Pratik Rana</span>\n            <span class=\"doc-side-meta\">Founder, Molar Labs</span>\n          </div>\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">Filed</span>\n            <span class=\"doc-side-meta\">May 2026 · Bengaluru</span>\n          </div>\n          <div class=\"doc-side-block\">\n            <span class=\"doc-side-label\">Read time</span>\n            <span class=\"doc-side-meta\">≈ 4 minutes</span>\n          </div>\n\n          <nav class=\"doc-toc\" aria-label=\"Sections\">\n            <a href=\"#new-shape\"><span>01</span>The new shape of code</a>\n            <a href=\"#bottleneck\"><span>02</span>Verification is the bottleneck</a>\n            <a href=\"#guard\"><span>03</span>Molar is a release guard</a>\n            <a href=\"#why-now\"><span>04</span>Why now</a>\n          </nav>\n        </aside>\n\n        <article class=\"doc-article\">\n<section id=\"new-shape\"><h2>Customers depend on more than your code.</h2>\n<p>A signup may involve your app, an identity provider, an email service, and a database. A purchase adds payment processing and a callback that grants access. Customers experience those steps as one task.</p>\n<p>When a handoff fails, each individual system can still look healthy. The button worked. The request returned. The customer is still waiting for an email or cannot use what they paid for.</p></section>\n<section id=\"bottleneck\"><h2>Test the handoffs customers rely on.</h2>\n<p>Unit tests, API tests, and browser tests each answer useful questions. Teams also need a way to follow the same action across the systems it touches.</p>\n<p>Take a team invitation. The admin should be able to invite a member; the email should contain the right link; the recipient should be able to accept it; and the workspace should grant the intended permissions. Testing only the “Invitation sent” message leaves most of that work unchecked.</p>\n<p>Molar combines browser agents with test services and run inspection so those handoffs are easier to exercise and investigate. Our <a href=\"/examples/team-invitation\">recorded invitation example</a> shows a controlled two-browser test using email and identity clones.</p></section>\n<section id=\"guard\"><h2>Build from one useful test to repeatable release checks.</h2>\n<p>Start with a task that matters: signing in, buying a plan, or inviting a teammate. Set up the accounts and services it needs, define success, and inspect what happens when the test runs.</p>\n<p>We are building toward a connected loop: explore an app, turn verified actions into reusable tests, run them during releases, and help engineers investigate and repair failures. <a href=\"/products/cartographer\">Cartographer</a>, <a href=\"/products/clones\">Clones</a>, <a href=\"/products/guard\">Guard</a>, and <a href=\"/products/trace\">Trace</a> are the parts of that system.</p>\n<p>The full loop is still being validated. Beta access focuses on a defined workflow; generated-test replay and automatic repair should not be assumed from a successful browser demonstration.</p></section>\n<section id=\"why-now\"><h2>Faster development needs checks people can understand.</h2>\n<p>As coding agents take on more implementation work, developers need to know what the changed app actually does. A useful result should explain the task attempted, the steps taken, the assertion checked, and anything that prevented completion.</p>\n<p>That is the standard we are building Molar around: a human or coding agent should be able to inspect the result, decide what to fix, and run the check again.</p>\n<p><a href=\"/company\">Read how Molar started</a>, <a href=\"/examples/autonomous-browser-check\">watch a recorded browser test</a>, or <a href=\"/contact\">bring us a workflow from your app</a>.</p></section>\n</article>\n      </div>\n    </div>\n  </main>\n\n  <footer>\n    <div class=\"frame foot-inner\">\n      <div>© 2026 Molar Labs · Bengaluru</div>\n      <div style=\"display:flex; gap:24px;\">\n        <a href=\"qa-agent.html\" style=\"color:inherit;text-decoration:none;\">QA Agent</a>\n        <a href=\"docs.html\" style=\"color:inherit;text-decoration:none;\">Docs</a>\n        <a href=\"thesis.html\" style=\"color:inherit;text-decoration:none;\">Thesis</a>\n        <a href=\"mailto:pratik@molar.it\" style=\"color:inherit;text-decoration:none;\">Email</a>\n        <a href=\"https://github.com/pratikranaa/molar-it\" style=\"color:inherit;text-decoration:none;\">GitHub</a>\n      </div>\n    </div>\n  </footer>\n\n  <script src=\"https://unpkg.com/react@18.3.1/umd/react.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/@babel/standalone@7.29.0/babel.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"site-config.js\"></script>\n  <script type=\"text/babel\" src=\"nav.jsx\"></script>\n  <script type=\"text/babel\" src=\"nav-boot.jsx\"></script>\n  <script src=\"waitlist-modal.js\"></script>\n</body>\n</html>\n",
  "integrations/github-actions.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Molar + GitHub Actions — CI/CD QA Integration</title>\n  <meta name=\"description\" content=\"Run Molar in GitHub Actions to gate pull requests with autonomous end-to-end tests. Install the CLI, wire molar-agent ci install, and block merges when critical paths fail.\" />\n  <meta property=\"og:title\" content=\"Molar + GitHub Actions — CI/CD QA Integration\" />\n  <meta property=\"og:description\" content=\"Gate PRs with Molar critical-path checks in GitHub Actions. Autonomous tests, traces, and required status checks.\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:url\" content=\"https://molar.it/integrations/github-actions\" />\n  <meta property=\"og:image\" content=\"https://molar.it/og.png\" />\n  <meta property=\"og:site_name\" content=\"Molar\" />\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Molar GitHub Actions Integration\" />\n  <meta name=\"twitter:image\" content=\"https://molar.it/og.png\" />\n  <link rel=\"canonical\" href=\"https://molar.it/integrations/github-actions\" />\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n      {\n        \"@type\": \"BreadcrumbList\",\n        \"itemListElement\": [\n          { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Molar\", \"item\": \"https://molar.it/\" },\n          { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"GitHub Actions\", \"item\": \"https://molar.it/integrations/github-actions\" }\n        ]\n      },\n      {\n        \"@type\": \"HowTo\",\n        \"name\": \"How to integrate Molar with GitHub Actions\",\n        \"description\": \"Install Molar CLI and gate pull requests with autonomous end-to-end tests in GitHub Actions.\",\n        \"step\": [\n          { \"@type\": \"HowToStep\", \"name\": \"Install\", \"text\": \"Run npx molar-agent init in your repository.\" },\n          { \"@type\": \"HowToStep\", \"name\": \"Scan\", \"text\": \"Point Molar at your staging or preview URL to author scenarios.\" },\n          { \"@type\": \"HowToStep\", \"name\": \"CI wire-up\", \"text\": \"Run molar-agent ci install to add the GitHub Actions workflow and required check.\" }\n        ]\n      }\n    ]\n  }\n  </script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"../styles.css\" />\n  <link rel=\"stylesheet\" href=\"../seo-pages.css\" />\n  <link rel=\"stylesheet\" href=\"../waitlist-modal.css\" />\n</head>\n<body data-waitlist-surface=\"integrations\">\n  <div class=\"paper-grain\"></div>\n  <div id=\"nav-root\"></div>\n  <main class=\"doc-page\">\n    <div class=\"frame\">\n      <div class=\"doc-meta\"><span class=\"num\">Integration</span><span class=\"rule\"></span><span>GitHub Actions</span></div>\n      <div class=\"doc-grid\">\n        <aside class=\"doc-sidebar\">\n          <div class=\"doc-side-block\"><span class=\"doc-side-label\">Requires</span><span class=\"doc-side-meta\">Node 18+ · GitHub repo</span></div>\n          <nav class=\"doc-toc\" aria-label=\"Sections\">\n            <a href=\"#overview\"><span>01</span>Overview</a>\n            <a href=\"#steps\"><span>02</span>Setup steps</a>\n            <a href=\"#checks\"><span>03</span>Required checks</a>\n          </nav>\n        </aside>\n        <article class=\"doc-article\">\n<section id=\"overview\"><h2>Run a configured browser scenario in CI.</h2>\n<p>Use the Molar CLI in GitHub Actions to run a scenario your project already defines. Start with a task you can reproduce locally, such as signing in or completing checkout in a test environment.</p>\n<p>The CI runner needs access to the application URL, the Molar project, and any test accounts or services the scenario uses. Configure those before adding the command to your workflow.</p></section>\n<section id=\"steps\"><h2>Connect the test environment, then run the scenario.</h2>\n<ol><li><strong>Set up the CLI and project.</strong> Follow the <a href=\"https://docs.molar.it\">current setup documentation</a> for installation and authentication.</li><li><strong>Prepare the test.</strong> Choose an existing scenario, confirm its assertions, and run it against your authorized test environment. Configure supported service clones if the test changes payment, email, or account state.</li><li><strong>Add the run command.</strong> After the application or preview deployment is ready, execute the scenario in your GitHub Actions job.</li><li><strong>Configure the repository check.</strong> Decide which job must pass before merging and enable that requirement in your repository settings.</li></ol>\n<pre><code># Example: run an existing scenario named checkout\nmolar run checkout --ci --json</code></pre>\n<p>This command runs the configured scenario and requests structured output. It does not generate the scenario, install a GitHub Actions workflow, or enable branch protection. Keep credentials in your CI secret store and follow the documented authentication setup.</p></section>\n<section id=\"checks\"><h2>Read the failure before deciding to merge.</h2>\n<p>Review the scenario status and any captured steps, screenshots, or trace links. Check whether the app failed an assertion, the test environment was unavailable, or the account could not sign in. These require different fixes.</p>\n<p>For example, a checkout scenario should verify the expected account access as well as the confirmation page. If the browser succeeds but the configured service check fails, investigate the payment callback or account update before treating the run as passed.</p>\n<p>Guard beta setup covers the scenario, environment, and release check you want to use. <a href=\"/products/guard\">Explore Guard</a> or <a href=\"/contact\">discuss your repository setup</a>. Automatic repair through Mender remains a preview capability.</p></section>\n</article>\n      </div>\n    </div>\n  </main>\n  <footer>\n    <div class=\"frame foot-inner\">\n      <div>© 2026 Molar Labs</div>\n      <div style=\"display:flex;gap:24px;flex-wrap:wrap;\">\n        <a href=\"/vs/cypress\" style=\"color:inherit;text-decoration:none;\">vs Cypress</a>\n        <a href=\"/docs\" style=\"color:inherit;text-decoration:none;\">Docs</a>\n        <a href=\"https://github.com/pratikranaa/molar-it\" style=\"color:inherit;text-decoration:none;\">GitHub</a>\n      </div>\n    </div>\n  </footer>\n  <script src=\"https://unpkg.com/react@18.3.1/umd/react.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://unpkg.com/@babel/standalone@7.29.0/babel.min.js\" crossorigin=\"anonymous\"></script>\n  <script src=\"../site-config.js\"></script>\n  <script type=\"text/babel\" src=\"../nav.jsx\"></script>\n  <script type=\"text/babel\" src=\"../nav-boot.jsx\"></script>\n  <script src=\"../waitlist-modal.js\"></script>\n</body>\n</html>\n"
}
